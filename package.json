{
  "name": "syncr",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "biome check --write --unsafe .",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "biome check --write .",
    "prepare": "husky",
    "check": "turbo lint && turbo typecheck && turbo test",
    "format:check": "biome check .",
    "clean:all": "turbo clean && rm -rf node_modules",
    "db:generate": "turbo db:generate --filter=@syncr/db",
    "db:migrate:dev": "cross-env APP_ENV=development turbo db:migrate --filter=@syncr/db",
    "db:migrate:dev:reset": "cross-env APP_ENV=development turbo db:reset --filter=@syncr/db",
    "db:migrate:preview:reset": "cross-env APP_ENV=preview turbo db:reset --filter=@syncr/db",
    "db:migrate:preview": "cross-env APP_ENV=preview turbo db:migrate --filter=@syncr/db",
    "db:migrate:prod": "cross-env APP_ENV=production turbo db:migrate --filter=@syncr/db",
    "db:seed:dev": "cross-env APP_ENV=development turbo db:seed --filter=@syncr/db",
    "db:seed:preview": "cross-env APP_ENV=preview turbo db:seed --filter=@syncr/db",
    "db:seed:prod": "cross-env APP_ENV=production turbo db:seed --filter=@syncr/db",
    "deploy:preview": "turbo deploy:preview --filter=@syncr/api",
    "deploy": "turbo deploy --filter=@syncr/api",
    "api": "turbo run dev --filter=@syncr/api",
    "api:tunnel": "turbo run tunnel --filter=@syncr/api",
    "api:dev:tunnel": "concurrently \"pnpm api\" \"pnpm api:tunnel\""
  },
  "keywords": [],
  "author": "frontendweb-sg",
  "license": "ISC",
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@types/node": "^26.0.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "tsx": "^4.22.4",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}