{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },

  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },

  "linter": {
    "enabled": true,

    "rules": {
      "preset": "recommended",

      "correctness": {
        "noUnusedVariables": "error"
      },

      "style": {
        "noNonNullAssertion": "warn"
      },

      "suspicious": {
        "noConsole": "off"
      }
    }
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "asNeeded"
    }
  }
}
