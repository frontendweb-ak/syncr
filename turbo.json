{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },

    "dev": {
      "persistent": true,
      "cache": false
    },

    "lint": {
      "outputs": []
    },

    "typecheck": {
      "outputs": []
    },

    "test": {
      "outputs": ["coverage/**"]
    }
  }
}